# Desarrollo: Vite reenvía estas rutas al backend sin peticiones entre orígenes.
VITE_API_URL=/api
VITE_AUTH_URL=/backend
VITE_STORAGE_URL=/storage
BACKEND_PROXY_TARGET=http://127.0.0.1:8000
# Producción: configurar estas URLs y el proxy del servidor de despliegue.

# Notificaciones en tiempo real (Laravel Reverb): copia REVERB_APP_KEY del .env del backend.
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
